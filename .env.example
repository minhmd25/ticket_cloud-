# Địa chỉ backend chung, không có dấu / ở cuối. Để trống khi dùng proxy của dev server
# (VITE_PROXY_TARGET) hoặc khi frontend và backend cùng một địa chỉ.
VITE_API_BASE_URL=
# Dev server chuyển tiếp /api tới địa chỉ này (chỉ dùng lúc phát triển).
VITE_PROXY_TARGET=http://localhost:3000
# true = dùng dữ liệu giả trong trình duyệt, false = gọi backend thật.
VITE_USE_MOCK=false
# Độ trễ giả lập (ms) cho chế độ dữ liệu giả.
VITE_MOCK_LATENCY_MS=350
