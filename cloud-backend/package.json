{
  "name": "event-ticketing-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API quản lý sự kiện và đặt vé (GCP) - outbox gửi sự kiện sang Azure",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:accounts": "tsx src/scripts/seed-accounts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "azure:smoke": "tsx src/scripts/azure-smoke.ts",
    "azure:report": "tsx src/scripts/azure-sent-report.ts",
    "token": "tsx src/scripts/make-token.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/storage-queue": "^12.32.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
