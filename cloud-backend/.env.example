# ---- Server ----
PORT=3000
NODE_ENV=development
# One origin or a comma-separated allowlist; use actual frontend URLs on Cloud Run.
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL (Cloud SQL trên GCP khi triển khai) ----
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
DB_POOL_MAX=5
# DB dùng cho kiểm thử (sẽ bị xóa dữ liệu mỗi lần chạy test)
TEST_DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing_test

# ---- Xác thực (Backend tài khoản) ----
# local: đăng nhập với bảng accounts, tự phát JWT HS256 và kiểm tra vai trò trong PostgreSQL
# mock : dùng header "Authorization: Bearer mock:<userId>:<role>" (role = customer|admin)
# jwt  : tự verify JWT bằng AUTH_JWT_SECRET (HS256) hoặc AUTH_JWT_PUBLIC_KEY (RS256)
# http : gọi sang Backend tài khoản AUTH_SERVICE_URL + AUTH_VERIFY_PATH để lấy {userId, role}
AUTH_MODE=local
# local cần một secret ngẫu nhiên ít nhất 32 byte. Sinh bằng crypto.randomBytes(32).
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600
# Chỉ dùng cho job seed:accounts trên môi trường demo dùng chung. Cấp từ Secret Manager.
# DEMO_CUSTOMER_PASSWORD=
# DEMO_ADMIN_PASSWORD=
AUTH_JWT_PUBLIC_KEY=
AUTH_SERVICE_URL=http://localhost:4000
AUTH_VERIFY_PATH=/auth/me
AUTH_TIMEOUT_MS=3000

# ---- Quy tắc nghiệp vụ ----
# Khách chỉ được hủy đơn nếu còn >= N giờ trước giờ diễn ra
CANCELLATION_DEADLINE_HOURS=24
MAX_TICKETS_PER_ORDER=10

# ---- Gửi sự kiện sang Azure (outbox -> Storage Queue "ticket-events") ----
# mock        : kiểm tra mẫu thông điệp như thật rồi chỉ ghi log (giả lập lỗi: PUBLISHER_MOCK_FAIL=true)
# azure-queue : gửi vào Azure Storage Queue bằng SAS URL (token chỉ quyền GHI, hết hạn 15/01/2027)
PUBLISHER_MODE=mock
PUBLISHER_MOCK_FAIL=false
# BÍ MẬT - không commit. Dán nguyên URL người làm Azure gửi, dạng
#   https://stticketsinh2026.queue.core.windows.net/ticket-events/messages?<SAS>   (có hay không "/messages" đều được)
AZURE_QUEUE_SAS_URL=
AZURE_TIMEOUT_MS=5000
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
# Thời gian một lượt worker giữ lô đã nhận (ms). Để trống = OUTBOX_BATCH_SIZE x AZURE_TIMEOUT_MS + 30s, tối thiểu 60s
OUTBOX_LEASE_MS=

# ---- Đọc thống kê từ Azure ----
# mock : giả lập API /stats của Azure từ DB cục bộ (để frontend phát triển)
# http : GET {AZURE_STATS_URL}/stats?... với header x-functions-key
STATS_MODE=mock
AZURE_STATS_URL=https://func-ticket-stats-sinh.azurewebsites.net/api
# BÍ MẬT - không commit, không đưa cho frontend
AZURE_STATS_KEY=
STATS_TIMEOUT_MS=60000
STATS_CACHE_TTL_MS=30000
